           <property name="styleSheet">
            <string notr="true">QLabel#label_TcpStatus, QLabel#label_CanStatus {
    background-color: #2C3E50;    /* 深蓝灰背景，比主窗口稍亮，体现层级 */
    color: #7F8C8D;               /* 默认文字颜色：暗灰色（表示无状态/未知） */
    border: 1px solid #34495E;    /* 边框：深灰色，融入背景 */
    border-radius: 6px;           /* 圆角：让标签更柔和 */
    padding: 4px 12px;            /* 内边距：让标签更饱满 */
    font-weight: bold;            /* 加粗 */
    font-size: 12px;              /* 字号适中 */
    min-width: 80px;              /* 最小宽度，保证视觉统一 */
    text-align: center;           /* 文字居中 */
}
/* CAN 初始化 - 蓝色 (新增建议) */
QLabel#label_CanStatus[canState=&quot;initializing&quot;] {
    color: #ECF0F1;
    background-color: #3498DB;    /* 科技蓝 */
    border-color: #3498DB;
}

/* CAN 就绪 - 绿色 */
QLabel#label_CanStatus[canState=&quot;ready&quot;] {
    color: #ECF0F1;
    background-color: #00E676;
    border-color: #00E676;
}

/* CAN 失败 - 红色 */
QLabel#label_CanStatus[canState=&quot;failed&quot;] {
    color: #ECF0F1;
    background-color: #FF5C5C;
    border-color: #FF5C5C;
}</string>

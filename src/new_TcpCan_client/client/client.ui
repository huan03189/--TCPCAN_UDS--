          <widget class="QLabel" name="label_TcpStatus">
           <property name="geometry">
            <rect>
             <x>140</x>
             <y>20</y>
             <width>106</width>
             <height>31</height>
            </rect>
           </property>
           <property name="styleSheet">
            <string notr="true">QLabel {
    background-color: #2C3E50;    /* 深蓝灰背景，比主窗口稍亮，体现层级 */
    color: #7F8C8D;               /* 默认文字颜色：暗灰色（表示无状态/未知） */
    border: 1px solid #34495E;    /* 边框：深灰色，融入背景 */
    border-radius: 6px;           /* 圆角：让标签更柔和 */
    padding: 4px 12px;            /* 内边距：让标签更饱满 */
    font-weight: bold;            /* 加粗 */
    font-size: 12px;              /* 字号适中 */
    min-width: 80px;              /* 最小宽度，保证视觉统一 */
    text-align: center;           /* 文字居中 */
}
/* TCP 就绪 - 绿色 */
QLabel#label_TcpStatus[tcpState=&quot;ready&quot;] {
    color: #ECF0F1;               /* 文字变白，更清晰 */
    background-color: #00E676;    /* 鲜艳的绿色背景 */
    border-color: #00E676;        /* 边框同色 */
}

/* TCP 重连 - 黄色 */
QLabel#label_TcpStatus[tcpState=&quot;reconnecting&quot;] {
    color: #2C3E50;               /* 文字变深，保证在黄底上可读 */
    background-color: #FFC107;    /* 琥珀色背景 */
    border-color: #FFC107;
}

/* TCP 断开 - 红色 */
QLabel#label_TcpStatus[tcpState=&quot;disconnected&quot;] {
    color: #ECF0F1;               /* 文字变白 */
    background-color: #FF5C5C;    /* 鲜艳的红色背景 */
    border-color: #FF5C5C;
}</string>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;center&quot;&gt;&lt;span style=&quot; font-size:9pt;&quot;&gt;未连接&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
          </widget>

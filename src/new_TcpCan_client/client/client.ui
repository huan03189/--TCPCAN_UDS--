       <property name="styleSheet">
        <string notr="true">QWidget {
    /* 1. 背景色：比主窗口背景（#2C3E50）稍亮一点，比如 #34495E */
    background-color: #34495E;

    /* 2. 圆角：让边角圆润，现代感强 */
    border-radius: 10px;

    /* 3. 边框：加一条细边框，增加精致感 */
    border: 1px solid #465a71;

    /* 4. 可选：加点内边距，防止内容贴边 */
    /* padding: 10px; */
}</string>
       </property>
       <layout class="QGridLayout" name="gridLayout">
        <item row="0" column="0">
         <widget class="QGroupBox" name="TCPgroupBox">
          <property name="styleSheet">
           <string notr="true">/* 内部卡片容器 (你的 GroupBox) */
QGroupBox {
    background-color: #34495E; /* 卡片背景色 */
    border: 1px solid #3B536B; /* 卡片边框 */
    border-radius: 6px; /* 圆角 */
    margin-top: 10px; /* 给标题留出空间 */
    padding: 15px; /* 内边距 */
    font-size: 13px;
    color: #ECF0F1; /* GroupBox 标题文字颜色 */
}

/* GroupBox 的标题 */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #1ABC9C; /* 标题文字高亮色 */
    font-weight: bold;
}

/* 内部的功能按钮 (你图片里的 PushButton) */
QPushButton {
    background-color: #1ABC9C; /* 主色调按钮 */
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 15px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #16A085; /* 悬停时颜色变深 */
}

QPushButton:pressed {
    background-color: #119078; /* 按下时颜色更深 */
}</string>
          </property>
          <property name="title">

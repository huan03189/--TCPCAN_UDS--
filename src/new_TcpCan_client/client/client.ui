       <property name="styleSheet">
        <string notr="true">QWidget {
    /* 1. 背景色：比主窗口背景（#2C3E50）稍亮一点，比如 #34495E */
    background-color: #34495E;

    /* 2. 圆角：让边角圆润，现代感强 */
    border-radius: 10px;

    /* 3. 边框：加一条细边框，增加精致感 */
    border: 1px solid #465a71;

    /* 4. 可选：加点内边距，防止内容贴边 */
    /* padding: 10px; */
}</string>
       </property>

       </property>
       <layout class="QGridLayout" name="gridLayout_3">
        <item row="0" column="0">
         <widget class="QGroupBox" name="UDSgroupBox">
          <property name="styleSheet">
           <string notr="true">/* 内部卡片容器 (你的 GroupBox) */
QGroupBox {
    background-color: #34495E; /* 卡片背景色 */
    border: none;             /* 去掉边框 */
    background-color: transparent; /* 背景透明，防止遮挡底色 */
    border-radius: 6px; /* 圆角 */
    margin-top: 10px; /* 给标题留出空间 */
    padding: 15px; /* 内边距 */
    font-size: 13px;
    color: #ECF0F1; /* GroupBox 标题文字颜色 */
}

/* GroupBox 的标题 */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #1ABC9C; /* 标题文字高亮色 */
    font-weight: bold;
}

/* 内部的功能按钮 (你图片里的 PushButton) */
QPushButton {
    background-color: #1ABC9C; /* 主色调按钮 */
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 15px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #16A085; /* 悬停时颜色变深 */
}

QPushButton:pressed {
    background-color: #119078; /* 按下时颜色更深 */
}</string>
          </property>
          <property name="title">
           <string>UDS快捷读取</string>
          </property>
          <widget class="QComboBox" name="comboBox_Channel">
           <property name="geometry">
            <rect>
             <x>430</x>
             <y>140</y>
             <width>104</width>
             <height>30</height>
            </rect>
           </property>
           <property name="styleSheet">
            <string notr="true">/* --- CAN 下拉框整体样式 --- */
QComboBox {  /* 建议给控件起个名字，比如 comboBox_Channel，这样只影响这一个 */
    background-color: #2980B9; /* 深蓝色背景，和上面的按钮颜色接近 */
    border: 1px solid #2980B9; /* 边框颜色 */
    border-radius: 5px;        /* 圆角，和按钮保持一致 */
    color: white;              /* 文字颜色 */
    padding: 5px;              /* 内边距，让文字不贴边 */
    min-height: 18px;          /* 最小高度，和上面的按钮高度一致 */
}

/* --- 下拉箭头部分的样式 --- */
QComboBoxl::down-arrow {
    image: url(:/icons/arrow_down_white.png); /* 可选：自定义白色箭头图标 */
    width: 12px;
    height: 12px;
}

/* --- 下拉菜单弹出时的样式 --- */
QComboBox QAbstractItemView {
    background-color: #2C3E50; /* 下拉菜单的背景色 */
    border: 1px solid #2980B9; /* 下拉菜单的边框 */
    color: white;              /* 下拉菜单文字颜色 */
    selection-background-color: #3498DB; /* 选中项的背景色 */
}</string>

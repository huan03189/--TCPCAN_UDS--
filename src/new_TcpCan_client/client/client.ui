          </property>
          <property name="maximumSize">
           <size>
            <width>521</width>
            <height>16777215</height>
           </size>
          </property>
          <property name="styleSheet">
           <string notr="true">QLineEdit, QTextEdit, QPlainTextEdit {
   background-color: #2C3E50; /* 和背景同色 */
    border: 1px solid #465a71; /* 加一个亮一点的边框 */
    border-radius: 4px;
    color: #FFFFFF; /* 文字白色 */
    padding: 5px;
}


/* QTextEdit 的只读模式（如果你想让它看起来像显示屏） */
QTextEdit[readOnly=&quot;true&quot;] {
    background-color: #1A252F; /* 更深的背景 */
    color: #2ECC71;            /* 绿色文字，像老式显示器 */
    border: 1px solid #2C3E50;
    font-family: &quot;Consolas&quot;, &quot;Courier New&quot;, monospace; /* 等宽字体，更极客 */
}</string>
          </property>
          <property name="readOnly">
           <bool>true</bool>
          </property>
         </widget>

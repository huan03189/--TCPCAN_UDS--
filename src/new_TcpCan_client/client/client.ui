          <property name="styleSheet">
           <string notr="true">QPushButton#btnClose, QPushButton#btnMax, QPushButton#btnMin {
    background-color: transparent; /* 透明背景 */
    border: none;                  /* 无边框 */
    color: #FFFFFF;                /* 白色文字或图标 */
    font-size: 14px;
    min-width: 26px;
    min-height: 26px;
}

/* 鼠标悬停效果 */
QPushButton#btnClose:hover {
    background-color: #E81123; /* 微软风格的红色关闭 */
    color: white;
}

QPushButton#btnMax:hover, QPushButton#btnMin:hover {
    background-color: #444444; /* 悬停变灰 */
}</string>
